{
  "name": "spatial-test-studio",
  "version": "0.1.0",
  "private": true,
  "description": "A browser workbench for designing and testing core rulesets.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "validate": "tsc --noEmit && vitest run --project unit && vite build && vitest run --project browser"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/lint": "^6.8.4",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.0",
    "@lezer/highlight": "^1.2.5",
    "ajv": "^8.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rpg-core": "git+https://github.com/bardic-inspiration/core.git#63ab4e2f19b943753aacdc74c865a6ca85ca05ce",
    "three": "^0.170.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^5.1.0"
  }
}
